<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.djh.mapper.OperateLogMapper">

    <!-- 操作日志列表 -->
    <select id="listLogs" resultType="com.djh.entity.OperateLog">
        select
        ol.*,
        u.name as operate_user_name
        from operate_log ol
        left join user u on ol.operate_user_id = u.id
        <where>
            <if test="operateUserName != null and operateUserName != ''">
                and u.name like concat('%', #{operateUserName}, '%')
            </if>
        </where>
        order by ol.operate_time desc
    </select>

</mapper>
